local LocalPlayer = Players.LocalPlayer

local function isPlayerAlive(player)
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function getPunchTool()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")

    if char and char:FindFirstChild("Punch") then
        return char.Punch
    end
    if backpack and backpack:FindFirstChild("Punch") then
        return backpack.Punch
    end
    return nil
end

local function getProteinEgg()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")

    if char and char:FindFirstChild("Protein Egg") then
        return char["Protein Egg"]
    end
    if backpack and backpack:FindFirstChild("Protein Egg") then
        return backpack["Protein Egg"]
    end
    return nil
end

local function killPlayer(target)
    local myChar = LocalPlayer.Character
    if not myChar then return end

    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    local hum = myChar:FindFirstChildOfClass("Humanoid")

    local punchTool = getPunchTool()
    if punchTool and punchTool.Parent == LocalPlayer.Backpack and hum then
        pcall(function()
            hum:EquipTool(punchTool)
        end)
    end

local proteinEgg = getProteinEgg()


if proteinEgg and proteinEgg.Parent == LocalPlayer.Backpack and hum then
    pcall(function()
        hum:EquipTool(proteinEgg)
    end)
end

if punchTool then
    local attackTime = punchTool:FindFirstChild("attackTime")
    if attackTime then
        attackTime.Value = 0
    end

    if punchTool.Parent == LocalPlayer.Backpack then
        punchTool.Parent = LocalPlayer.Character
    end
end

    local leftHand = myChar:FindFirstChild("LeftHand") or myChar:FindFirstChild("Left Arm")
    local rightHand = myChar:FindFirstChild("RightHand") or myChar:FindFirstChild("Right Arm")
    local muscleEvent = LocalPlayer:FindFirstChild("muscleEvent")

    local startTime = tick()
    while isPlayerAlive(target) and tick() - startTime < 3 do
        local targetChar = target.Character
        if not targetChar then break end

        local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
        if not targetHRP then break end

   
        pcall(function()
            myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 2.2)
        end)

        if punchTool and punchTool.Parent == LocalPlayer.Backpack and hum then
            pcall(function()
                hum:EquipTool(punchTool)
            end)
        end
        if proteinEgg and proteinEgg.Parent == LocalPlayer.Backpack and hum then
            pcall(function()
                hum:EquipTool(proteinEgg)
            end)
        end

        if leftHand then
            pcall(function()
                firetouchinterest(targetHRP, leftHand, 0)
                firetouchinterest(targetHRP, leftHand, 1)
            end)
        end
        if rightHand then
            pcall(function()
                firetouchinterest(targetHRP, rightHand, 0)
                firetouchinterest(targetHRP, rightHand, 1)
            end)
        end

        -- Real punch remote
        if muscleEvent then
            pcall(function()
                muscleEvent:FireServer("punch", "leftHand")
                muscleEvent:FireServer("punch", "rightHand")
            end)
        end

        if punchTool then
            pcall(function()
                punchTool:Activate()
            end)
        end

        task.wait(0.04)
    end
end


