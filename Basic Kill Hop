local function ServerHop()
    local placeId = game.PlaceId
    local myJobId = game.JobId

    for attempt = 1, 6 do
        local success, response = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(
                "https://games.roblox.com/v1/games/"
                    .. placeId
                    .. "/servers/Public?sortOrder=Desc&limit=100"
            ))
        end)

        if not success or not response or not response.data then
            task.wait(2 + attempt)
            continue
        end

        local candidates = {}

        for _, srv in response.data do
            if srv.id == myJobId then continue end
            if srv.playing >= srv.maxPlayers then continue end
            if srv.playing < 8 then continue end

            local fill = srv.playing / srv.maxPlayers

            if fill > 0.25 and fill < 0.9 then
                table.insert(candidates, srv)
            end
        end

        if #candidates == 0 then
            task.wait(3 + attempt * 1.5)
            continue
        end

        local target = candidates[math.random(1, #candidates)]

        pcall(function()
            TeleportService:TeleportToPlaceInstance(
                placeId,
                target.id,
                LocalPlayer
            )
        end)

        task.wait(5 + attempt * 2)
        return
    end
end

task.spawn(function()
    while true do
        if AutoServerHopEnabled
            and (os.clock() - LastServerHop) >= ServerHopInterval then

            LastServerHop = os.clock()
            task.spawn(ServerHop)
        end

        task.wait(1)
    end
end)


local tab = window:AddTab("Kill Hop")



local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local localPlayer = Players.LocalPlayer

local tpLoop = false

local punchRadius = 15
local punchDelay = 0.05

local largePunchRadius = 50
local punchRepeatDelay = 0.1

-- Get local player's character
local function getCharacter()
    return localPlayer.Character
end

-- Find the Punch tool
local function getPunchTool()
    local character = getCharacter()
    if not character then
        return nil
    end

    local tool = character:FindFirstChild("Punch")

    if not tool then
        local backpack = localPlayer:FindFirstChildOfClass("Backpack")
        if backpack then
            tool = backpack:FindFirstChild("Punch")
        end
    end

    return tool
end


local function equipPunch()
    local character = getCharacter()
    if not character then
        return nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local tool = getPunchTool()

    if humanoid and tool and tool.Parent ~= character then
        humanoid:EquipTool(tool)


        task.wait()
    end

    return tool
end

local function getPlayersInRange()
    local character = getCharacter()
    local hrp = character and character:FindFirstChild("HumanoidRootPart")

    if not hrp then
        return {}
    end

    local inRangePlayers = {}

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer then

            local targetChar = plr.Character
            local targetHRP = targetChar
                and targetChar:FindFirstChild("HumanoidRootPart")

            local targetHumanoid = targetChar
                and targetChar:FindFirstChildOfClass("Humanoid")

            if targetHRP
                and targetHumanoid
                and targetHumanoid.Health > 0 then

                local distance =
                    (targetHRP.Position - hrp.Position).Magnitude

                if distance <= largePunchRadius then
                    table.insert(inRangePlayers, targetHumanoid)
                end
            end
        end
    end

    return inRangePlayers
end

local function punchAndKill()
    task.spawn(function()

        while tpLoop do

            local tool = equipPunch()

            if not tool then
                task.wait(punchDelay)
                continue
            end


            local character = getCharacter()

            if tool.Parent ~= character then
                equipPunch()
            end

            local playersInRange = getPlayersInRange()

            if #playersInRange > 0 then


                for _, humanoid in ipairs(playersInRange) do

                    if not tpLoop then
                        break
                    end

                    if humanoid
                        and humanoid.Parent
                        and humanoid.Health > 0 then

                        tool:Activate()

                        task.wait(punchRepeatDelay)
                    end
                end

            else
                tool:Activate()

                task.wait(punchRepeatDelay)
            end
        end
    end)
end


local function startTpLoop()
    task.spawn(function()

        while tpLoop do

            local players = Players:GetPlayers()

            for _, plr in ipairs(players) do

                if not tpLoop then
                    break
                end

                if plr == localPlayer then
                    continue
                end

                local targetChar = plr.Character

                local targetHRP = targetChar
                    and targetChar:FindFirstChild("HumanoidRootPart")

                local targetHumanoid = targetChar
                    and targetChar:FindFirstChildOfClass("Humanoid")

                if targetHRP
                    and targetHumanoid
                    and targetHumanoid.Health > 0 then

                    local character = getCharacter()
                    local hrp = character
                        and character:FindFirstChild("HumanoidRootPart")

                    if hrp then
                        hrp.CFrame = targetHRP.CFrame

                        task.wait(0.2)
                    end
                end
            end

            task.wait(0.1)
        end
    end)
end

local switch = tab:AddSwitch("Kill Everybody", function(state)

    tpLoop = state

    if state then
        startTpLoop()
        punchAndKill()
    end
end)


