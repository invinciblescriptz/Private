    local interval = tonumber(value)

    if interval and interval > 0 then
        ServerHopInterval = interval
    end
end, {
    ["clear"] = false,
    ["placeholder"] = "90"
})

local function ServerHop()
    local placeId = game.PlaceId
    local myJobId = game.JobId

    for attempt = 1, 6 do
        local success, response = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(
                "https://games.roblox.com/v1/games/"
                    .. placeId
                    .. "/servers/Public?sortOrder=Desc&limit=100"
            ))
        end)

        if not success or not response or not response.data then
            task.wait(2 + attempt)
            continue
        end

        local candidates = {}

        for _, srv in response.data do
            if srv.id == myJobId then continue end
            if srv.playing >= srv.maxPlayers then continue end
            if srv.playing < 8 then continue end

            local fill = srv.playing / srv.maxPlayers

            if fill > 0.25 and fill < 0.9 then
                table.insert(candidates, srv)
            end
        end

        if #candidates == 0 then
            task.wait(3 + attempt * 1.5)
            continue
        end

        local target = candidates[math.random(1, #candidates)]

        pcall(function()
            TeleportService:TeleportToPlaceInstance(
                placeId,
                target.id,
                LocalPlayer
            )
        end)

        task.wait(5 + attempt * 2)
        return
    end
end

task.spawn(function()
    while true do
        if AutoServerHopEnabled
            and (os.clock() - LastServerHop) >= ServerHopInterval then

            LastServerHop = os.clock()
            task.spawn(ServerHop)
        end

        task.wait(1)
    end
end)


local tab = window:AddTab("Kill")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local localPlayer = Players.LocalPlayer
local tpLoop = false
local lockedTarget = nil
local lockStartTime = 0
local LOCK_DURATION = 0.5

local function getCharacter()
	return localPlayer.Character
end

local function getAllValidPlayers()
	local valid = {}

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= localPlayer then
			local targetChar = plr.Character
			local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
			local targetHumanoid = targetChar and targetChar:FindFirstChildOfClass("Humanoid")

			if targetHRP and targetHumanoid and targetHumanoid.Health > 0 then
				table.insert(valid, targetHRP)
			end
		end
	end

	return valid
end

local currentIndex = 1

local function getNextTarget()
	local players = getAllValidPlayers()
	if #players == 0 then
		return nil
	end

	if currentIndex > #players then
		currentIndex = 1
	end

	local target = players[currentIndex]
	currentIndex = currentIndex + 1
	return target
end

local function startLockLoop()
	task.spawn(function()
		while tpLoop do
			local character = getCharacter()
			local hrp = character and character:FindFirstChild("HumanoidRootPart")

			if not hrp then
				task.wait(0.1)
				continue
			end

			local now = tick()

			if not lockedTarget
				or not lockedTarget.Parent
				or not lockedTarget.Parent:FindFirstChildOfClass("Humanoid")
				or lockedTarget.Parent:FindFirstChildOfClass("Humanoid").Health <= 0
				or (now - lockStartTime) >= LOCK_DURATION
			then
				lockedTarget = getNextTarget()
				lockStartTime = now
			end

			if lockedTarget then
				hrp.CFrame = lockedTarget.CFrame * CFrame.new(0, 0, 3) 
			end

			task.wait()
		end

		lockedTarget = nil
	end)
end

local switch = tab:AddSwitch("Kill Everybody", function(state)
	tpLoop = state
	if state then
		lockedTarget = nil
		currentIndex = 1
		startLockLoop()
	else
		lockedTarget = nil
	end
end)

tpLoop = true
startLockLoop()



local PunchBoost = {
    Current = nil 
}

local function getToolName()
    if PunchBoost.Current == "Egg" then
        return "Protein Egg"
    elseif PunchBoost.Current == "Shake" then
        return "Tropical Shake"
    end
    return nil
end

local function doPunchAndEquip()
    local player = game.Players.LocalPlayer
    local character = player.Character
    local backpack = player:FindFirstChild("Backpack")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local toolName = getToolName()

    if not (humanoid and backpack and toolName) then return end

    local punch = backpack:FindFirstChild("Punch") or (character and character:FindFirstChild("Punch"))
    if punch then
        pcall(function()
            humanoid:EquipTool(punch)
        end)
        pcall(function()
            player.muscleEvent:FireServer("punch", "rightHand")
        end)
    end


    local item = backpack:FindFirstChild(toolName) or (character and character:FindFirstChild(toolName))
    if item then
        pcall(function()
            humanoid:EquipTool(item)
        end)
    end
end


task.spawn(function()
    while true do
        if PunchBoost.Current then
            doPunchAndEquip()
        end
        task.wait(0.12)
    end
end)

